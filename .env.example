# Shared secret Vapi sends in the x-tool-secret header on every tool call.
# The service refuses requests without it. Locally it falls back to
# "dev-secret"; in a container (REQUIRE_TOOL_SECRET=1) it must be set or the
# process refuses to start. Generate one with: openssl rand -hex 32
TOOL_SECRET=

# Where the agreements SQLite database is written.
# Local default: ./agreements.db at the repo root.
# Container default (set in the Dockerfile): /data/agreements.db — mount a
# volume at /data so agreements survive redeploys.
#DB_PATH=/data/agreements.db

# Port uvicorn binds to. Defaults to 8000. Platforms like Fly/Railway inject
# their own PORT; the container CMD honours it.
#PORT=8000

# Set to 1 to refuse startup when TOOL_SECRET is unset. The Dockerfile sets
# this; leave it unset for local development.
#REQUIRE_TOOL_SECRET=1
